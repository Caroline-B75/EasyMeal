-# Partial dashboard — utilisateur connecté
-# Affiche les actions contextuelles : brouillon, menu actif, ou création

- if @active_menu
  = render "home/dashboard_active", active_menu: @active_menu

- if @draft
  = render "home/dashboard_draft", draft: @draft, active_menu: @active_menu

- if @active_menu.nil? && @draft.nil?
  -# === Aucun menu : incitation à en créer un ===
  .hero-card.hero-card--empty
    %h2.hero-card-title Prêt à composer ton premier menu ?
    %p.hero-card-note
      Choisis ton régime et le nombre de personnes : on génère le menu et sa liste de courses.
    .hero-card-actions.hero-card-actions--inline
      = link_to "Créer un nouveau menu", new_menu_path, class: "btn-hero"
      = link_to "Voir les recettes", recipes_path, class: "btn-hero btn-hero--secondary"
