- content_for :title, "Ingrédients"

-# Container avec le controller modal pour gérer les suppressions
.ingredients-container{ data: { controller: "modal" } }
  .ingredients-header
    %h1 Tes ingrédients
    - if policy(Ingredient).create?
      = link_to "Ajouter un ingrédient", new_ingredient_path, class: "btn btn-primary"

  -# Filtres et recherche — le formulaire se soumet de lui-même à chaque
  -# changement (contrôleur `filter-form`), il n'a donc pas de bouton d'envoi.
  -# Il vit hors du turbo-frame qu'il recharge : jamais re-rendu, donc le focus
  -# et le curseur restent dans le champ de recherche pendant la frappe.
  - filters_active = [params[:query], params[:category], params[:month], params[:seasonal]].any?(&:present?)
  - month_names = t("date.month_names")
  .ingredients-filters
    = form_with url: ingredients_path, method: :get, class: "search-form",
                data: { turbo_frame: "ingredients_list", controller: "filter-form" } do |f|
      .search-group
        = f.text_field :query, value: params[:query],
                       placeholder: "Rechercher un ingrédient...",
                       class: "search-input",
                       data: { action: "input->filter-form#submitDebounced keydown.enter->filter-form#submit" }

        = f.select :category,
                   options_for_select(Ingredient.enum_options(:category), params[:category]),
                   { include_blank: "Tous les rayons" },
                   class: "filter-select", data: { action: "change->filter-form#submit" }

        = f.select :month,
                   options_for_select((1..12).map { |m| [month_names[m], m] }, params[:month]),
                   { include_blank: "Tous les mois" },
                   class: "filter-select", data: { action: "change->filter-form#submit" }

        %label.season-checkbox
          = f.check_box :seasonal,
                        { checked: params[:seasonal] == "true", data: { action: "change->filter-form#submit" } },
                        "true", nil
          %span Ingrédients de saison

        -# Lien plutôt que bouton : effacer les filtres revient à revenir à
        -# l'index nu, ce qu'une navigation fait déjà très bien. Sa visibilité,
        -# elle, suit les filtres en direct — d'où l'état initial rendu ici et
        -# repris ensuite par le contrôleur.
        = link_to "Effacer les filtres", ingredients_path,
                  class: "btn btn-link#{' hidden' unless filters_active}",
                  data: { filter_form_target: "clear" }

  -# Table des ingrédients
  = turbo_frame_tag "ingredients_list" do
    - if @ingredients.any?
      .table-container
        %table.ingredients-table
          %thead
            %tr
              %th Nom
              %th.category-column Rayon
              %th Saison
              %th.actions-column Actions
          %tbody
            - abbr_month_names = t("date.abbr_month_names")
            - @ingredients.each do |ingredient|
              %tr
                %td.ingredient-name-cell{ data: { label: "Nom" } }
                  %strong
                    = link_to ingredient.name, ingredient_path(ingredient), class: "ingredient-name-link", data: { turbo_frame: "_top" }
                    %span.unit-inline= "(#{ingredient.base_unit})"
                  - if ingredient.aliases.present?
                    %small.aliases= ingredient.aliases.is_a?(Array) ? ingredient.aliases.join(', ') : ingredient.aliases.values.join(', ')

                %td.category-cell{ data: { label: "Rayon" } }
                  %span.category-badge{ data: { category: ingredient.category } }
                    = Ingredient.enum_label(:category, ingredient.category)

                %td{ data: { label: "Saison" } }
                  - if ingredient.season_months.present? && ingredient.season_months.length == 12
                    %span.text-muted Toute l'année
                  - elsif ingredient.season_months.present?
                    .season-months
                      - ingredient.season_months.sort.each do |month|
                        %span.month-tag= abbr_month_names[month]

                %td.actions-cell{ data: { label: "Actions" } }
                  - if policy(ingredient).edit?
                    = link_to edit_ingredient_path(ingredient), class: "icon-btn edit-btn", title: "Modifier", data: { turbo_frame: "_top" } do
                      %svg{ width: "16", height: "16", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2" }
                        %path{ d: "M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" }
                        %path{ d: "M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" }

                  - if policy(ingredient).destroy?
                    = button_to ingredient_path(ingredient), method: :delete, class: "icon-btn delete-btn", title: "Supprimer", form: { style: "display: inline;", data: { action: "submit->modal#open" } } do
                      %svg{ width: "16", height: "16", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2" }
                        %polyline{ points: "3 6 5 6 21 6" }
                        %path{ d: "M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" }

      -# Pagination Pagy
      .pagination-container
        != pagy_nav(@pagy) if @pagy.pages > 1

    - else
      .empty-state
        .empty-state-icon
          = svg_icon(:leaf, size: 56)
        %h2 Aucun ingrédient trouvé
        %p Ajuste ta recherche ou ajoute un premier ingrédient à ton catalogue.
        - if policy(Ingredient).create?
          = link_to "Ajouter un ingrédient", new_ingredient_path, class: "btn btn-primary"

  -# Modal de confirmation de suppression
  = render "shared/delete_confirmation_modal"
