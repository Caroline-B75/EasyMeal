-# Formulaire pour créer/éditer un ingrédient avec SimpleForm
-# `ingredient_form_units_value` alimente le contrôleur Stimulus avec la seule
-# source de vérité de la correspondance groupe d'unités → unité de base
= simple_form_for ingredient, html: { class: "ingredient-form", data: { controller: "ingredient-form form-errors", ingredient_form_units_value: Ingredient::BASE_UNITS, turbo: false } } do |f|

  = f.error_notification message: "Des erreurs empêchent la sauvegarde :"

  .form-group
    = f.input :name, 
              label: "Nom de l'ingrédient *",
              placeholder: "Ex: Tomates",
              input_html: { class: "form-input" },
              label_html: { class: "form-label" },
              error_class: "has-error"

  .form-group
    = f.input :category, 
              label: "Rayon *",
              collection: Ingredient.enum_options(:category),
              prompt: "Sélectionnez un rayon",
              input_html: { class: "form-select" },
              label_html: { class: "form-label" },
              hint_html: { class: "form-hint" },
              error_class: "has-error"

  .form-group
    = f.input :unit_group, 
              label: "Groupe d'unités *",
              collection: Ingredient.enum_options(:unit_group),
              prompt: "Sélectionnez un groupe",
              input_html: { class: "form-select", data: { ingredient_form_target: "unitGroup", action: "change->ingredient-form#updateBaseUnit" } },
              label_html: { class: "form-label" },
              hint_html: { class: "form-hint" },
              error_class: "has-error"

  .form-group
    = f.input :base_unit, 
              label: "Unité de base *",
              hint: "Déterminée automatiquement",
              placeholder: "Ex: g, ml, piece, cac",
              readonly: true,
              input_html: { class: "form-input", data: { ingredient_form_target: "baseUnit" } },
              label_html: { class: "form-label" },
              hint_html: { class: "form-hint" },
              error_class: "has-error"

  .form-group
    = f.input :piece_weight_g,
              label: "Poids d'une pièce (g)",
              hint: "Facultatif — fait le pont quand une recette compte ce que le catalogue pèse (1 aubergine ≈ 300 g). Ingrédients en masse ou en pièces uniquement.",
              placeholder: "Ex: 300",
              input_html: { class: "form-input", step: "0.01", min: "0.01" },
              label_html: { class: "form-label" },
              hint_html: { class: "form-hint" },
              error_class: "has-error"

  -# Second coefficient de conversion, symétrique du précédent. Quand la valeur
  -# affichée vient de l'IA, l'indication le dit et rappelle qu'enregistrer vaut
  -# vérification : le formulaire est le seul endroit d'où sort une densité
  -# `manual` (cf. IngredientsController#ingredient_params).
  .form-group
    = f.input :density_g_per_ml,
              label: "Densité (g/ml)",
              hint: density_field_hint(ingredient),
              placeholder: "Ex: 0.55",
              input_html: { class: "form-input", step: "0.01", min: "0.01", max: Ingredient::MAX_DENSITY },
              label_html: { class: "form-label" },
              hint_html: { class: "form-hint" },
              error_class: "has-error"

  .form-group
    %label.form-label Alias (synonymes)
    %small.form-hint Noms alternatifs pour faciliter ta recherche
    = text_field_tag "ingredient[aliases]", 
                     ingredient.aliases.is_a?(Array) ? ingredient.aliases.join(', ') : '', 
                     class: "form-input", 
                     placeholder: "Ex: tomate, tomate fraîche (séparés par des virgules)"

  = render "ingredients/season_months", ingredient: ingredient, id_prefix: "ingredient",
                                        hint: "Coche les mois où cet ingrédient est de saison"

  .form-actions
    = f.submit ingredient.new_record? ? "Créer l'ingrédient" : "Mettre à jour", class: "btn btn-primary"
    = link_to "Annuler", ingredients_path, class: "btn btn-secondary"
