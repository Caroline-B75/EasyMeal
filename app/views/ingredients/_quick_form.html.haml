-# Formulaire de création rapide d'ingrédient dans un slideout
-# Utilisé depuis le formulaire de recette pour ajouter un ingrédient à la volée
-# Soumet en AJAX et dispatch un événement pour mettre à jour les selects

= simple_form_for ingredient, url: quick_create_ingredients_path, html: { class: "ingredient-form ingredient-form-slideout", id: "quick-ingredient-form-content", data: { controller: "ingredient-form", ingredient_form_units_value: Ingredient::BASE_UNITS } } do |f|

  .slideout-form-content
    = f.error_notification message: "Des erreurs empêchent la sauvegarde :"

    .form-group
      = f.input :name, label: "Nom de l'ingrédient *", placeholder: "Ex: Tomates", input_html: { class: "form-input", autofocus: true }, label_html: { class: "form-label" }, error_class: "has-error"

    .form-group
      = f.input :category, label: "Rayon *", collection: Ingredient.enum_options(:category), prompt: "Sélectionne un rayon", input_html: { class: "form-select" }, label_html: { class: "form-label" }, error_class: "has-error"

    .form-group
      = f.input :unit_group, label: "Groupe d'unités *", collection: Ingredient.enum_options(:unit_group), prompt: "Sélectionne un groupe", input_html: { class: "form-select", data: { ingredient_form_target: "unitGroup", action: "change->ingredient-form#updateBaseUnit" } }, label_html: { class: "form-label" }, error_class: "has-error"

    .form-group
      = f.input :base_unit, label: "Unité de base *", hint: "Déterminée automatiquement", readonly: true, input_html: { class: "form-input", data: { ingredient_form_target: "baseUnit" } }, label_html: { class: "form-label" }, hint_html: { class: "form-hint" }, error_class: "has-error"

    -# Champs optionnels repliables
    %details.optional-fields
      %summary.optional-fields-toggle
        %span Options avancées

      .optional-fields-content
        -# Renseignés ici, les deux coefficients de conversion servent
        -# immédiatement : c'est le panneau d'import qui vient d'ouvrir ce
        -# formulaire, et il posera la quantité détectée en la convertissant.
        -# Les laisser vides n'est pas grave — l'import estimera la densité au
        -# besoin, et la signalera alors comme telle.
        .form-group
          = f.input :piece_weight_g, label: "Poids d'une pièce (g)", hint: "Ex: 300 pour une aubergine, 40 pour une tranche de jambon", input_html: { class: "form-input", step: "0.01", min: "0.01" }, label_html: { class: "form-label" }, hint_html: { class: "form-hint" }, error_class: "has-error"

        .form-group
          = f.input :piece_volume_ml, label: "Volume d'une pièce (ml)", hint: "Ex: 1000 pour une brique de lait, 200 pour un pot de crème", input_html: { class: "form-input", step: "0.01", min: "0.01" }, label_html: { class: "form-label" }, hint_html: { class: "form-hint" }, error_class: "has-error"

        -# Le nom de la pièce décide de tout l'affichage à l'achat : renseigné,
        -# la liste de courses compte des pièces (« 2 tablettes (400 g) ») ;
        -# vide, elle pèse. Le pluriel régulier suffit ici — le formulaire
        -# complet a le champ pour les exceptions.
        .form-group
          = f.input :piece_label, label: "Nom de la pièce", hint: "Ex: pièce, tranche, brique — l'ingrédient s'affichera alors en pièces dans la liste de courses", input_html: { class: "form-input" }, label_html: { class: "form-label" }, hint_html: { class: "form-hint" }, error_class: "has-error"

        .form-group
          = f.input :density_g_per_ml, label: "Densité (g/ml)", hint: "Ex: 0.55 pour la farine, 1.42 pour le miel — pour peser ce qu'une recette dose à la cuillère", input_html: { class: "form-input", step: "0.01", min: "0.01", max: Ingredient::MAX_DENSITY }, label_html: { class: "form-label" }, hint_html: { class: "form-hint" }, error_class: "has-error"

        .form-group
          %label.form-label Alias (synonymes)
          %small.form-hint Noms alternatifs (séparés par des virgules)
          = text_field_tag "ingredient[aliases]", "", class: "form-input", placeholder: "Ex: tomate cerise, cherry tomato"

        = render "ingredients/season_months", ingredient: ingredient, id_prefix: "quick_ingredient",
                                              hint: "Mois où l'ingrédient est de saison"

  .slideout-form-actions
    = f.submit "Créer l'ingrédient", class: "btn btn-primary"
    %button.btn.btn-secondary{ type: "button", data: { action: "click->slideout#close" } }
      Annuler
