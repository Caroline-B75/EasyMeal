-# Notification de succès après création d'un ingrédient
-# Ce partial est injecté via Turbo Stream dans #ingredient-created-notification
-# Il contient un élément invisible avec le controller ingredient-created qui :
-# 1. Inscrit l'ingrédient au catalogue du formulaire — modèle de ligne compris,
-#    dont sont clonées les lignes suivantes
-# 2. L'ajoute à la recette en cours, sans quantité
-# 3. Affiche un flash message dans le container global (.flash-messages)
-# 4. Ferme le slideout

-# Élément invisible qui déclenche le JavaScript
.ingredient-created-event{ data: { controller: "ingredient-created", ingredient_created_id_value: ingredient.id, ingredient_created_name_value: ingredient.name, ingredient_created_option_label_value: ingredient.select_label, ingredient_created_base_unit_value: ingredient.base_unit, ingredient_created_unit_group_value: ingredient.unit_group, ingredient_created_piece_weight_value: ingredient.piece_weight_g, ingredient_created_piece_volume_value: ingredient.piece_volume_ml, ingredient_created_piece_label_value: ingredient.piece_label, ingredient_created_density_value: ingredient.density_g_per_ml, ingredient_created_density_source_value: ingredient.density_source } }
