- content_for :title, @ingredient.name

= context_bar_back(ingredients_path, "Retour à la liste", variant: :narrow)

.show-container
  .show-header
    %h1= @ingredient.name

  .show-card
    .detail-grid
      .detail-item
        %span.detail-label Rayon
        %span.detail-value
          %span.category-badge{ data: { category: @ingredient.category } }
            = Ingredient.enum_label(:category, @ingredient.category)

      .detail-item
        %span.detail-label Unité de mesure
        %span.detail-value
          = Ingredient.enum_label(:unit_group, @ingredient.unit_group)
          = "(#{@ingredient.base_unit})"

      - if @ingredient.aliases.present?
        .detail-item
          %span.detail-label Alias
          %span.detail-value
            = @ingredient.aliases.is_a?(Array) ? @ingredient.aliases.join(', ') : @ingredient.aliases.values.join(', ')

      - if @ingredient.season_months.present?
        .detail-item
          %span.detail-label Mois de saison
          .detail-value
            .season-months
              - @ingredient.season_months.sort.each do |month|
                %span.month-tag= Date::ABBR_MONTHNAMES[month]

    .show-actions
      - if policy(@ingredient).edit?
        = link_to "Modifier", edit_ingredient_path(@ingredient), class: "btn btn-primary"
      - if policy(@ingredient).destroy?
        = button_to "Supprimer", ingredient_path(@ingredient), method: :delete, data: { turbo_confirm: "Es-tu sûr(e) de vouloir supprimer cet ingrédient ?" }, class: "btn btn-danger"
