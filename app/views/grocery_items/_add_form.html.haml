-# Formulaire « Ajouter un article » : la liste de courses (UC3) et les courses
-# habituelles (UC8, étape 3) décrivent un article de la même façon.
-# url         : où envoyer l'article
-# scope       : clé des paramètres envoyés (:grocery_item, :usual_grocery_item)
-# compact     : (facultatif) un seul champ tant qu'on n'écrit rien — quantité,
-#               unité et rayon n'apparaissent qu'à la saisie (page des habituels)
-# placeholder : (facultatif) l'exemple écrit dans le champ « Article »
-#
-# Un seul champ pour deux chemins, sans rien à choisir avant de taper : si
-# l'article est au catalogue, l'autocomplétion pose son rayon et restreint
-# ses unités ; sinon la saisie reste ce qu'elle a toujours été — un nom, une
-# quantité, une unité, un rayon. Le formulaire fonctionne sans JavaScript :
-# le serveur rattache alors l'article par son nom (Ingredient.recognize).
-# Une saisie en cours n'est pas effacée par un rafraîchissement en direct
-# (data-morph-guard, cf. morph_keep.js).
- compact = local_assigns[:compact]
= form_with url: url, method: :post, scope: scope, class: [ "grocery-add-form", ("grocery-add-form--compact" if compact) ],
            data: { controller: "form-reset ingredient-combobox",
                    action: "turbo:submit-end->form-reset#reset turbo:submit-end->ingredient-combobox#reset click@window->ingredient-combobox#closeOnOutsideClick",
                    "ingredient-combobox-search-url-value": search_ingredients_path,
                    morph_guard: true } do |f|
  .grocery-add-row
    .form-group.grocery-add-article
      -# Compact, le champ se passe de titre à l'écran : son exemple le dit
      = f.label :name, "Article", class: [ "form-label", ("sr-only" if compact) ]
      = f.text_field :name, placeholder: local_assigns.fetch(:placeholder, "Ex: Sel fin"), class: "form-input", required: true,
                     autocomplete: "off", role: "combobox",
                     aria: { expanded: "false", autocomplete: "list", controls: "grocery-suggestions" },
                     data: { "ingredient-combobox-target": "nameInput",
                             action: "input->ingredient-combobox#search keydown->ingredient-combobox#navigate" }
      -# Posé par l'autocomplétion : c'est lui qui fait d'une ligne libre
      -# un article du catalogue.
      = f.hidden_field :ingredient_id, data: { "ingredient-combobox-target": "ingredientId" }
      %ul#grocery-suggestions.grocery-suggestions{ role: "listbox", hidden: true,
                                                   "aria-label": "Ingrédients du catalogue",
                                                   data: { "ingredient-combobox-target": "results" } }

    .form-group.grocery-add-qty
      = f.label :quantity, "Quantité", class: "form-label"
      -# Le seul champ qui reste à remplir quand l'article est reconnu :
      -# l'autocomplétion y amène le curseur.
      = f.number_field :quantity, placeholder: "250", min: 0.01, step: 0.01, class: "form-input",
                       data: { "ingredient-combobox-target": "quantityInput" }

    .form-group.grocery-add-unit
      = f.label :unit, "Unité", class: "form-label"
      -# Toutes les unités tant qu'aucun article n'est reconnu ; celles de
      -# l'ingrédient dès qu'il l'est (cf. le contrôleur Stimulus).
      = f.select :unit, Units.all_select_options, { prompt: "Unité…" },
                 class: "form-select", data: { "ingredient-combobox-target": "unitSelect" }

    .form-group.grocery-add-shelf{ data: { "ingredient-combobox-target": "categoryGroup" } }
      = f.label :category, "Rayon", class: "form-label"
      -# Libellés côté Ingredient : les rayons sont une seule table (Ingredient::CATEGORIES)
      = f.select :category, Ingredient.enum_options(:category), { prompt: "Rayon…" }, class: "form-select"

    -# Prend la place du sélecteur de rayon quand le catalogue a répondu :
    -# le rayon n'est plus une question, il se lit — et se défait.
    .form-group.grocery-add-known{ hidden: true, data: { "ingredient-combobox-target": "knownGroup" } }
      %span.form-label Rayon
      .grocery-add-chip
        %span.grocery-add-chip-label{ data: { "ingredient-combobox-target": "chipLabel" } }
        %button.btn-remove{ type: "button", "aria-label": "Détacher l'ingrédient du catalogue",
                            title: "Saisir le rayon et l'unité moi-même",
                            data: { action: "click->ingredient-combobox#unlink" } }
          = svg_icon(:x, size: 12)

    .grocery-add-submit
      -# « + » seul sur une rangée, « + Ajouter » une fois le formulaire
      -# empilé en mobile : le libellé n'est masqué que là où sa largeur
      -# manquait au rayon.
      %button.btn.btn-primary{ type: "submit", "aria-label": "Ajouter l'article", title: "Ajouter l'article" }
        = svg_icon(:plus, size: 16)
        %span.grocery-add-btn-label Ajouter
