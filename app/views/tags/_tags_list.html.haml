-# Partial pour la liste des tags (utilisé par Turbo).
-# Tags groupés par type, en accordéons repliables (comme la liste de courses).
-# Le controller grocery-accordion est générique : il pilote `hidden` sur le
-# corps et `aria-expanded` sur l'en-tête (le chevron est stylé via l'ARIA).
- Tag.grouped_by_type(tags).each do |type_key, type_label, group_tags|
  - section_id = "tag_group_#{type_key}"
  .tag-group{ data: { controller: "grocery-accordion", "grocery-accordion-open-value": "true" } }
    %button.tag-group-header{ type: "button",
                              "aria-expanded": "true",
                              "aria-controls": "#{section_id}_body",
                              data: { action: "click->grocery-accordion#toggle",
                                      "grocery-accordion-target": "header" } }
      %span.tag-group-title= type_label
      %span.tag-group-count{ "aria-label": "#{group_tags.size} #{group_tags.size > 1 ? 'tags' : 'tag'}" }= group_tags.size
      %span.tag-group-chevron{ "aria-hidden": "true" }

    %ul.tag-group-body{ id: "#{section_id}_body",
                        data: { "grocery-accordion-target": "body" } }
      - group_tags.each do |tag|
        %li.tag-row{ id: dom_id(tag) }
          -# Mode affichage : nom + utilisation
          .tag-display{ data: { tag_inline_target: "display" } }
            %span.tag-row-name= tag.name
            - count = recipe_counts.fetch(tag.id, 0)
            - if count > 0
              %span.tag-row-usage= "#{count} #{count > 1 ? 'recettes' : 'recette'}"
            - else
              %span.tag-row-usage.text-muted Aucune recette

          -# Mode édition inline (caché par défaut)
          .tag-edit-form{ data: { tag_inline_target: "form" }, style: "display: none;" }
            = form_with model: tag,
                        url: tag_path(tag),
                        method: :patch,
                        data: { turbo_frame: "tags_list" } do |f|
              = f.text_field :name,
                             class: "tag-inline-input",
                             data: { tag_inline_target: "input" },
                             required: true
              %button.btn-icon-save{ type: "submit", "aria-label": "Enregistrer", title: "Enregistrer" }
                = svg_icon(:check, size: 18)
              %button.btn-icon-cancel{ type: "button",
                                      "aria-label": "Annuler",
                                      title: "Annuler",
                                      data: { action: "click->tag-inline#cancel" } }
                = svg_icon(:x, size: 18)

          -# Actions (masquées pendant l'édition)
          .tag-row-actions
            = link_to "#", class: "icon-btn edit-btn",
                           "aria-label": "Modifier le tag #{tag.name}",
                           title: "Modifier",
                           data: { action: "click->tag-inline#edit" } do
              = svg_icon(:edit, size: 16)

            = button_to tag_path(tag), method: :delete, class: "icon-btn delete-btn", "aria-label": "Supprimer le tag #{tag.name}", title: "Supprimer", form: { style: "display: inline;", data: { action: "submit->modal#open" } } do
              = svg_icon(:trash, size: 16)
