!!!
%html{ lang: "fr" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }
    %title Hors ligne — EasyMeal
    -# application.css est pré-cachée par le service worker : disponible hors-ligne.
    = stylesheet_link_tag "application"
    :css
      /* Styles autonomes de la page offline (charte EasyMeal). */
      .offline {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 1rem;
        padding: 2rem;
        background: var(--color-bg-main, #F8F7F4);
        color: var(--color-ink, #1C1917);
      }
      .offline__logo { width: 140px; height: auto; }
      .offline__title { margin: 0; font-size: 1.5rem; }
      .offline__text {
        margin: 0;
        max-width: 30rem;
        color: var(--color-ink-3, #78716C);
        line-height: 1.5;
      }
      .offline__link {
        margin-top: .5rem;
        padding: .75rem 1.5rem;
        border-radius: 999px;
        background: var(--color-primary, #1C1917);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .offline__link:hover {
        background: var(--color-primary-hover, #44403C);
        color: #fff;
        text-decoration: none;
      }
  %body
    %main.offline
      = image_tag "logos/logo_EasyMeal.svg", alt: "EasyMeal", class: "offline__logo"
      %h1.offline__title Tu es hors ligne
      %p.offline__text
        Impossible de charger cette page. Vérifie ta connexion internet, puis réessaie.
      = link_to "Retour à l'accueil", root_path, class: "offline__link"
