-# authentication.css est déjà inclus dans le bundle global application.css :
-# pas de stylesheet_link_tag séparé ici (évite un asset data-turbo-track qui
-# force un rechargement complet lors des visites Turbo).
.auth-container
  .auth-card
    .auth-header.user-form-header
      %h1.auth-title Créer un compte
      %p.auth-subtitle Rejoins EasyMeal et simplifie tes repas !

    = simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'auth-form' }) do |f|
      = f.error_notification

      .form-fields
        / Username
        .form-group
          = f.input :username, required: true, autofocus: true, input_html: { class: 'form-input', autocomplete: "username", placeholder: "Choisis un nom d'utilisateur" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

        / First Name & Last Name (side by side)
        .form-row
          .form-group.form-group-half
            = f.input :first_name, required: true, input_html: { class: 'form-input', autocomplete: "given-name", placeholder: "Ton prénom" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

          .form-group.form-group-half
            = f.input :last_name, required: true, input_html: { class: 'form-input', autocomplete: "family-name", placeholder: "Ton nom" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

        / Gender
        .form-group
          = f.input :gender, required: true, collection: [['Homme', 'male'], ['Femme', 'female']], input_html: { class: 'form-input' }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

        / Email
        .form-group
          = f.input :email, required: true, input_html: { class: 'form-input', autocomplete: "email", placeholder: "votre.email@exemple.com" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

        / Password
        .form-group
          = f.input :password, required: true, hint: "Minimum 6 caractères", input_html: { class: 'form-input', autocomplete: "new-password", placeholder: "••••••••" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

        / Password Confirmation
        .form-group
          = f.input :password_confirmation, required: true, input_html: { class: 'form-input', autocomplete: "new-password", placeholder: "••••••••" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

      / Submit Button
      .form-actions
        = f.button :submit, "Créer mon compte", class: "btn btn-primary btn-large"

    / Footer Links
    .auth-footer
      = render "devise/shared/links"
