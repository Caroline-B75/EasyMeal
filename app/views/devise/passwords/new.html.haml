-# authentication.css est déjà inclus dans le bundle global application.css :
-# pas de stylesheet_link_tag séparé ici (évite un asset data-turbo-track qui
-# force un rechargement complet lors des visites Turbo — le spinner infini
-# décrit dans devise/sessions/new).
.auth-container
  .auth-card
    .auth-header.user-form-header
      %h1.auth-title Mot de passe oublié ?
      %p.auth-subtitle On t'envoie un lien pour réinitialiser ton mot de passe

    = simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'auth-form' }) do |f|
      = f.error_notification

      .form-fields
        / Email
        .form-group
          = f.input :email, required: true, autofocus: true, input_html: { class: 'form-input', autocomplete: "email", placeholder: "ton.email@exemple.com" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

      / Submit Button
      .form-actions
        = f.button :submit, "Envoyer le lien", class: "btn btn-primary btn-large"

    / Footer Links
    .auth-footer
      = render "devise/shared/links"
