- content_for :head do
  = stylesheet_link_tag "authentication", "data-turbo-track": "reload"

.auth-container
  .auth-card
    .auth-header
      %h1.auth-title Mot de passe oublié ?
      %p.auth-subtitle On t'envoie un lien pour réinitialiser ton mot de passe

    = simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'auth-form' }) do |f|
      = f.error_notification

      .form-fields
        / Email
        .form-group
          = f.input :email, required: true, autofocus: true, input_html: { class: 'form-input', autocomplete: "email", placeholder: "votre.email@exemple.com" }, label_html: { class: 'form-label' }, wrapper_html: { class: 'input-wrapper' }

      / Submit Button
      .form-actions
        = f.button :submit, "Envoyer le lien", class: "btn btn-primary btn-large"

    / Footer Links
    .auth-footer
      = render "devise/shared/links"
