-# Page de création d'une nouvelle recette (admin only)
- content_for :title, "Nouvelle recette"

= context_bar_back(recipes_path, "Retour aux recettes", variant: :narrow)

-# Mini hero sombre
.rf-hero
  .rf-hero-inner
    .rf-kicker
      %span.rf-kicker-line
      NOUVELLE RECETTE
    %h1.rf-hero-title Créer une recette

.rf-body
  = render "form", recipe: @recipe
