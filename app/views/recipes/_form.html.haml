-# Formulaire partagé pour création/édition de recette
-# Design Slate Craft Premium — cohérent avec la fiche recette

.recipe-form-wrapper{ data: { controller: "slideout" } }
  = form_with model: recipe, class: "rf-form", data: { controller: "nested-form form-errors", turbo: false } do |f|

    -# Informations générales — section sans intitulé : les libellés des champs
    -# se suffisent. Le nom occupe sa propre ligne, puis les trois valeurs
    -# chiffrées de la recette se partagent la ligne suivante.
    .rf-section
      .form-row
        -# Le nom se saisit comme un titre : pas de libellé visible (le placeholder
        -# le porte), un simple trait sous le champ. Le label reste dans le DOM en
        -# .sr-only pour que le champ garde son intitulé au lecteur d'écran.
        .form-group{ class: field_error_class(recipe, :name) }
          = f.label :name, "Nom de la recette *", class: "sr-only"
          = f.text_field :name, class: "form-input rf-name-input", placeholder: "Nom de la recette", required: true
          = field_errors(recipe, :name)

      -# Les valeurs chiffrées se lisent comme une phrase — « Pour 4 personnes ·
      -# Préparation 20 min · Cuisson 15 min » — plutôt que comme trois champs
      -# étiquetés : libellés en ligne, unité à l'intérieur du champ. Chaque unité
      -# est reliée à son champ par aria-describedby, pour que le lecteur d'écran
      -# annonce la phrase telle qu'elle se lit.
      .rf-measures
        .rf-measure{ class: field_error_class(recipe, :default_servings) }
          = f.label :default_servings, "Pour", class: "form-label"
          -# Stepper − / + : le champ reste saisissable (taper « 12 » va plus vite
          -# que douze clics) et porte seul la borne basse, lue par le contrôleur.
          .rf-unit-field.rf-stepper{ data: { controller: "number-stepper" } }
            %button.rf-stepper-btn{ type: "button", "aria-label": "Retirer une personne",
                                    data: { action: "number-stepper#decrement",
                                            number_stepper_target: "decrement" } } −
            = f.number_field :default_servings, class: "form-input",
                             min: 1, required: true, value: recipe.default_servings || 4,
                             aria: { describedby: "recipe_servings_unit" },
                             data: { number_stepper_target: "input", action: "input->number-stepper#refresh" }
            %button.rf-stepper-btn{ type: "button", "aria-label": "Ajouter une personne",
                                    data: { action: "number-stepper#increment",
                                            number_stepper_target: "increment" } } +
          %span.rf-measure-unit#recipe_servings_unit personnes

        -# Ponctuation de la phrase : masquée aux lecteurs d'écran, et retirée
        -# en CSS dès que la rangée se replie sur plusieurs lignes.
        %span.rf-measure-sep{ "aria-hidden": "true" } ·

        .rf-measure{ class: field_error_class(recipe, :prep_time_minutes) }
          = f.label :prep_time_minutes, "Préparation", class: "form-label"
          .rf-unit-field.rf-duration
            = f.number_field :prep_time_minutes, class: "form-input", min: 0, placeholder: "—",
                             aria: { describedby: "recipe_prep_unit" }
            %span.rf-unit-suffix#recipe_prep_unit min

        .rf-measure{ class: field_error_class(recipe, :cook_time_minutes) }
          = f.label :cook_time_minutes, "Cuisson", class: "form-label"
          .rf-unit-field.rf-duration
            = f.number_field :cook_time_minutes, class: "form-input", min: 0, placeholder: "—",
                             aria: { describedby: "recipe_cook_unit" }
            %span.rf-unit-suffix#recipe_cook_unit min

        -# Une erreur éventuelle passe sous la rangée entière, jamais entre deux
        -# groupes qui couperaient la phrase en deux.
        = field_errors(recipe, :default_servings)
        = field_errors(recipe, :prep_time_minutes)
        = field_errors(recipe, :cook_time_minutes)

    -# Section : Photo
    -# Une photo déjà en place se remplace via « Changer de photo », qui révèle
    -# la zone de dépôt ; sinon celle-ci est visible d'emblée. Un seul bloc
    -# d'upload dans les deux cas, piloté par l'attribut hidden.
    .rf-section
      .rf-section-label PHOTO

      - photo_attached = recipe.persisted? && recipe.photo.attached?
      .form-group.rf-photo{ data: { controller: "image-preview" } }
        - if photo_attached
          = image_tag cloudinary_photo_url(recipe.photo, width: 200, height: 150), class: "photo-preview", width: 200, height: 150, loading: "lazy"
          %button.btn.btn-secondary{ type: "button", data: { image_preview_target: "changeButton", action: "click->image-preview#showUploadField" } }
            Changer de photo

        .rf-photo-upload{ data: { image_preview_target: "uploadArea" }, hidden: photo_attached }
          -# La zone entière est le label du champ fichier : elle est donc
          -# cliquable, et le glisser-déposer y réinjecte le fichier déposé.
          %label.rf-dropzone{ for: "recipe_photo", data: { image_preview_target: "dropzone", action: "dragover->image-preview#dragOver dragleave->image-preview#dragLeave drop->image-preview#dropFile" } }
            = svg_icon(:camera, size: 24, css_class: "rf-dropzone-icon")
            %span.rf-dropzone-title Dépose une photo ici
            %span.rf-dropzone-hint ou clique pour choisir — JPEG/PNG, 800×600 minimum
          = f.file_field :photo, accept: "image/*", id: "recipe_photo", class: "photo-upload-input sr-only", data: { image_preview_target: "input", action: "change->image-preview#showFilename" }
          %p.photo-upload-notice{ data: { image_preview_target: "notice" }, hidden: true }

    -# Section : Caractéristiques
    .rf-section
      .rf-section-label CARACTÉRISTIQUES

      -# Les quatre caractéristiques se lisent comme quatre rangées d'options
      -# alignées sur une même colonne d'intitulés : chaque vocabulaire est
      -# visible en entier, sans dérouler de liste. Les moments et le régime
      -# sont obligatoires (validations du modèle), la difficulté et le budget
      -# se laissent effacer en recliquant sur l'option active.
      -#
      -# Les moments ouvrent la section : ce sont eux qui déterminent où la
      -# recette peut tomber dans un menu, donc la première question qu'on se
      -# pose devant une recette à classer.
      -# Multi-sélection obligatoire (sauf brouillon IA, cf. HasMealTypes),
      -# dans l'ordre où la journée se déroule. Libellés compacts : cinq moments
      -# se partagent la largeur d'un écran de téléphone, où « Petit-déjeuner »
      -# ne tient pas — c'est exactement le registre de MealTypes.compact_label.
      = render "recipes/segmented_field", f: f, attribute: :meal_types,
               label: "Moment(s) du repas *", multiple: true, required: true,
               options: MealTypes::MEAL_TYPES.map { |type| [MealTypes.compact_label(type), type] }

      = render "recipes/segmented_field", f: f, attribute: :diet,
               label: "Régime alimentaire *", options: Recipe.enum_options(:diet), required: true

      = render "recipes/segmented_field", f: f, attribute: :difficulty,
               label: "Difficulté", options: Recipe.enum_options(:difficulty)

      = render "recipes/segmented_field", f: f, attribute: :price,
               label: "Budget", options: Recipe.enum_options(:price)

    -# Section : Tags
    .rf-section
      .rf-section-label TAGS

      .form-group
        -# N'affiche que les catégories qui ont des tags (Tag.grouped_by_type ignore les groupes vides)
        - Tag.grouped_by_type(Tag.alphabetical).each do |_type_key, type_label, group_tags|
          .rf-tags-group
            .rf-tags-category= type_label
            .tags-grid
              - group_tags.each do |tag|
                %label.tag-checkbox
                  = f.check_box :tag_ids, { multiple: true, checked: recipe.tags.include?(tag) }, tag.id, nil
                  %span.tag-name= tag.name

    -# Panneau IA (brouillon uniquement — juste au-dessus des ingrédients)
    - if @ai_matches.present?
      = render "recipes/ai_ingredients_panel", ai_matches: @ai_matches

    -# Section : Ingrédients (nested fields)
    .rf-section
      .rf-section-label INGRÉDIENTS

      - if recipe.errors[:base].any?
        .field-errors
          - recipe.errors[:base].each do |message|
            %span.field-error= message

      .preparations-container{ data: { nested_form_target: "container" } }
        %template{ data: { nested_form_target: "template" } }
          = f.fields_for :preparations, Preparation.new, child_index: "NEW_RECORD" do |pf|
            = render "recipes/preparation_fields", f: pf

        = f.fields_for :preparations do |pf|
          = render "recipes/preparation_fields", f: pf

      .preparations-actions
        %button.btn.btn-primary{ type: "button", data: { action: "click->nested-form#add" } }
          = svg_icon(:plus, size: 16)
          Ajouter un ingrédient

        %button.btn.btn-secondary{ type: "button", data: { action: "click->slideout#open" } }
          = svg_icon(:plus, size: 16)
          Créer un nouvel ingrédient

      #ingredient-created-notification

    -# Section : Instructions
    .rf-section
      .rf-section-label PRÉPARATION

      .form-group{ class: field_error_class(recipe, :instructions) }
        = f.label :instructions, "Étapes de préparation", class: "form-label"
        = f.text_area :instructions, class: "form-textarea", rows: 10, placeholder: "Faire bouillir l'eau...\nAjouter les pâtes...\n..."
        = field_errors(recipe, :instructions)

    -# Actions du formulaire
    .rf-actions
      - if recipe.persisted? && recipe.draft?
        -# Brouillon IA : publier = sauvegarder + changer le statut en un seul clic
        %button.btn.btn-primary.btn-lg{ type: "submit", name: "_publish", value: "1" }
          = svg_icon(:check, size: 16)
          Publier la recette
        = f.submit "Sauvegarder", class: "btn btn-secondary"
      - else
        = f.submit recipe.new_record? ? "Créer la recette" : "Mettre à jour", class: "btn btn-primary"
        = link_to "Annuler", recipes_path, class: "btn btn-link"

  -# Slideout pour créer un ingrédient à la volée
  .slideout-overlay{ data: { slideout_target: "overlay", action: "click->slideout#closeOnOverlay" } }
  .slideout-panel{ data: { slideout_target: "panel" } }
    .slideout-header
      %h3 Créer un nouvel ingrédient
      %button.slideout-close{ type: "button", data: { action: "click->slideout#close" } }
        = svg_icon(:x, size: 18)
    .slideout-content#quick-ingredient-form
      = render "ingredients/quick_form", ingredient: Ingredient.new