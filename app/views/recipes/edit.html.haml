-# Page d'édition d'une recette existante (admin only)
- content_for :title, "Modifier #{@recipe.name}"

= context_bar_back(recipe_path(@recipe), "Retour à la recette", variant: :narrow)

-# Mini hero sombre
.rf-hero
  .rf-hero-inner
    .rf-kicker
      %span.rf-kicker-line
      MODIFICATION
    %h1.rf-hero-title= @recipe.name

.rf-body
  = render "form", recipe: @recipe
