!!!
%html{ lang: "fr" }
  %head
    - page_title = content_for(:title) || "EasyMeal"
    -# Description par défaut, surchargeable par page via content_for(:description)
    - page_description = content_for?(:description) ? content_for(:description) : "Planifie tes menus de la semaine et génère automatiquement ta liste de courses."
    %title= page_title
    -# viewport-fit=cover : le contenu s'étend sous l'encoche / la barre d'état (voir env(safe-area-inset-*) en CSS)
    %meta{name: "viewport", content: "width=device-width,initial-scale=1,viewport-fit=cover"}
    %meta{name: "description", content: page_description}

    -# PWA / iOS — rendu « app-like »
    -# theme-color : cohérent avec le manifest ; colore l'UI du navigateur hors app installée
    %meta{name: "theme-color", content: "#1C1917"}
    -# mobile-web-app-capable est la meta standard ; apple-mobile-web-app-capable (dépréciée) conservée pour iOS ancien
    %meta{name: "mobile-web-app-capable", content: "yes"}
    %meta{name: "apple-mobile-web-app-capable", content: "yes"}
    %meta{name: "apple-mobile-web-app-title", content: "EasyMeal"}
    -# Charte claire → barre d'état « default » (texte sombre sur fond clair, lisible sur le header)
    %meta{name: "apple-mobile-web-app-status-bar-style", content: "default"}

    -# Open Graph — aperçu de partage (catalogue public)
    %meta{property: "og:site_name", content: "EasyMeal"}
    %meta{property: "og:title", content: page_title}
    %meta{property: "og:description", content: page_description}
    %meta{property: "og:type", content: "website"}
    %meta{property: "og:url", content: request.original_url}
    %meta{property: "og:image", content: "#{request.base_url}/icon-512-v4.png"}

    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    %link{rel: "manifest", href: pwa_manifest_path}
    -# favicon.ico (16/32/48) : le seul fichier que les navigateurs vont chercher à la
    -# racine sans lire le HTML — barre de favoris, historique, page « nouvel onglet ».
    -# Son nom et son emplacement sont imposés par la convention : ni chemin ni suffixe de version.
    %link{rel: "icon", href: "/favicon.ico", sizes: "48x48"}
    -# Onglet : version vectorielle, nette à toute taille et à tout zoom. Les
    -# navigateurs qui l'ignorent (Safari < 16.4) retombent sur le favicon.ico.
    %link{rel: "icon", href: "/icon.svg", type: "image/svg+xml"}
    -# apple-touch-icon : PNG 180x180 opaque plein cadre (fond paprika #C0392B), sans alpha ni coins arrondis (iOS applique son propre masque)
    %link{rel: "apple-touch-icon", sizes: "180x180", href: "/apple-touch-icon-v4.png"}
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body{ class: ("home-page" if home_page?) }
    -# Skip-link accessibilité : premier élément focusable, visible au focus uniquement.
    -# Permet aux utilisateurs clavier / lecteurs d'écran d'aller directement au contenu.
    = link_to "Aller au contenu", "#main-content", class: "skip-link"

    -# Indicateur global d'état réseau (PWA) — bandeau discret « Hors ligne » /
    -# « Synchronisation… ». Masqué par défaut, affiché via le controller Stimulus.
    .network-status{ data: { controller: "network-status" }, role: "status", "aria-live": "polite" }
      %span.network-status__dot
      %span.network-status__text{ data: { "network-status-target": "text" } }

    -# Flash messages — turbo_stream cible l'id "flash" pour les mises à jour dynamiques.
    -# aria-live="polite" : les messages injectés dynamiquement (Turbo Streams) sont
    -# annoncés par les lecteurs d'écran. role="status" renforce le support.
    #flash{ role: "status", "aria-live": "polite" }
      = render "shared/flash"

    -# Navigation principale responsive
    - if user_signed_in?
      - admin_draft_count = current_user.admin? ? Recipe.draft.count : 0
      - active_menu = current_active_menu
      - draft_menu = current_draft_menu
      %header.main-header{ data: { controller: "sticky-header" } }
        %nav.nav-container{ data: { controller: "menu" } }
          .nav-brand
            = link_to root_path, class: "brand-link" do
              = image_tag "logos/logo_EasyMeal.svg", alt: "EasyMeal", class: "logo"

          -# Liens de navigation principaux (desktop uniquement)
          .header-nav-links
            - if active_menu
              = link_to "Menu actif", menu_path(active_menu), class: header_nav_class(:current, active_menu)
            - if draft_menu
              = link_to "Menu brouillon", menu_path(draft_menu), class: header_nav_class(:draft, draft_menu)
            = link_to "Recettes", recipes_path, class: header_nav_class(:recipes)
            - if active_menu
              = link_to "Courses", grocery_menu_path(active_menu), class: header_nav_class(:grocery, active_menu)
            -# Import IA (admin) : le badge compte les brouillons en attente de validation
            - if current_user.admin?
              = link_to recipe_drafts_path, class: header_nav_class(:drafts) do
                Import
                - if admin_draft_count > 0
                  %span.nav-badge= admin_draft_count

          -# Menu utilisateur (avatar desktop / hamburger mobile)
          .user-menu
            %button.user-menu-button{ type: "button",
                                      "aria-haspopup": "true",
                                      "aria-expanded": "false",
                                      "aria-controls": "user-menu-dropdown",
                                      "aria-label": "Menu utilisateur",
                                      data: { action: "click->menu#toggle", menu_target: "button" } }
              .user-avatar= user_initials(current_user)
              %span.user-name= current_user.first_name
              %svg.chevron{ width: "12", height: "12", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "3" }
                %polyline{ points: "6 9 12 15 18 9" }
              -# Icône hamburger (visible uniquement sur mobile via CSS)
              %svg.hamburger-icon{ width: "22", height: "22", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2" }
                %line{ x1: "3", y1: "6", x2: "21", y2: "6" }
                %line{ x1: "3", y1: "12", x2: "21", y2: "12" }
                %line{ x1: "3", y1: "18", x2: "21", y2: "18" }

            .user-dropdown#user-menu-dropdown{ data: { menu_target: "dropdown" } }
              -# En-tête d'identité (mobile uniquement) : ancre la notion de « profil »
              -# et la distingue clairement des liens de navigation qui suivent.
              .dropdown-identity
                .dropdown-identity-avatar= user_initials(current_user)
                .dropdown-identity-body
                  %span.dropdown-identity-name= "#{current_user.first_name} #{current_user.last_name}"
                  %span.dropdown-identity-email= current_user.email
              .dropdown-divider

              -# Liens de navigation dans le dropdown (tablette/mobile uniquement via CSS)
              .dropdown-nav-links
                - if active_menu
                  = link_to "Menu actif", menu_path(active_menu), class: "dropdown-link"
                - if draft_menu
                  = link_to "Menu brouillon", menu_path(draft_menu), class: "dropdown-link"
                = link_to "Recettes", recipes_path, class: "dropdown-link"
                - if active_menu
                  = link_to "Courses", grocery_menu_path(active_menu), class: "dropdown-link"
                - if current_user.admin?
                  = link_to recipe_drafts_path, class: "dropdown-link dropdown-link--admin" do
                    Import
                    - if admin_draft_count > 0
                      %span.nav-badge= admin_draft_count
                .dropdown-divider

              .dropdown-links
                = link_to "Mes menus", menus_path, class: "dropdown-link"
                = link_to "Préférences", preferences_profile_path, class: "dropdown-link"
                -# « Mon compte » suit « Préférences » : les deux se règlent une
                -# fois pour toutes, mais celui-ci touche à l'identité et au mot
                -# de passe, pas à la façon de composer les menus.
                = link_to "Mon compte", edit_user_registration_path, class: "dropdown-link"
                - if current_user.admin?
                  = link_to "Utilisateurs", users_path, class: "dropdown-link dropdown-link--admin"
                = link_to "Me déconnecter", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-link logout"
    - else
      %header.main-header.auth-header{ data: { controller: "sticky-header" } }
        %nav.nav-container
          .nav-brand
            = link_to root_path, class: "brand-link" do
              = image_tag "logos/logo_EasyMeal.svg", alt: "EasyMeal", class: "logo"
          .nav-links
            = link_to "Se connecter", new_user_session_path, class: "nav-link"
            = link_to "S'inscrire", new_user_registration_path, class: "nav-link btn-signup"

    -# tabindex="-1" : la cible du skip-link doit pouvoir recevoir le focus
    -# programmatiquement (sinon certains navigateurs ne font que scroller).
    %main#main-content.main-content{ tabindex: "-1" }
      = yield
