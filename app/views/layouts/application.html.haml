!!!
%html{ lang: "fr" }
  %head
    - page_title = content_for(:title) || "EasyMeal"
    -# Description par défaut, surchargeable par page via content_for(:description)
    - page_description = content_for?(:description) ? content_for(:description) : "Planifie tes menus de la semaine et génère automatiquement ta liste de courses."
    %title= page_title
    -# viewport-fit=cover : le contenu s'étend sous l'encoche / la barre d'état (voir env(safe-area-inset-*) en CSS)
    %meta{name: "viewport", content: "width=device-width,initial-scale=1,viewport-fit=cover"}
    %meta{name: "description", content: page_description}

    -# PWA / iOS — rendu « app-like »
    -# theme-color : cohérent avec le manifest ; colore l'UI du navigateur hors app installée
    %meta{name: "theme-color", content: "#1C1917"}
    -# mobile-web-app-capable est la meta standard ; apple-mobile-web-app-capable (dépréciée) conservée pour iOS ancien
    %meta{name: "mobile-web-app-capable", content: "yes"}
    %meta{name: "apple-mobile-web-app-capable", content: "yes"}
    %meta{name: "apple-mobile-web-app-title", content: "EasyMeal"}
    -# Charte claire → barre d'état « default » (texte sombre sur fond clair, lisible sur le header)
    %meta{name: "apple-mobile-web-app-status-bar-style", content: "default"}

    -# Open Graph — aperçu de partage (catalogue public)
    %meta{property: "og:site_name", content: "EasyMeal"}
    %meta{property: "og:title", content: page_title}
    %meta{property: "og:description", content: page_description}
    %meta{property: "og:type", content: "website"}
    %meta{property: "og:url", content: request.original_url}
    %meta{property: "og:image", content: "#{request.base_url}/icon-512.png"}

    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    %link{rel: "manifest", href: pwa_manifest_path}
    %link{rel: "icon", href: "/icon-192.png", type: "image/png"}
    -# apple-touch-icon : PNG 180x180 opaque (fond #F8F7F4), à fournir dans public/apple-touch-icon.png
    %link{rel: "apple-touch-icon", sizes: "180x180", href: "/apple-touch-icon.png"}
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body{ class: ("home-page" if home_page?) }
    -# Skip-link accessibilité : premier élément focusable, visible au focus uniquement.
    -# Permet aux utilisateurs clavier / lecteurs d'écran d'aller directement au contenu.
    = link_to "Aller au contenu", "#main-content", class: "skip-link"

    -# Indicateur global d'état réseau (PWA) — bandeau discret « Hors ligne » /
    -# « Synchronisation… ». Masqué par défaut, affiché via le controller Stimulus.
    .network-status{ data: { controller: "network-status" }, role: "status", "aria-live": "polite" }
      %span.network-status__dot
      %span.network-status__text{ data: { "network-status-target": "text" } }

    -# Flash messages — turbo_stream cible l'id "flash" pour les mises à jour dynamiques.
    -# aria-live="polite" : les messages injectés dynamiquement (Turbo Streams) sont
    -# annoncés par les lecteurs d'écran. role="status" renforce le support.
    #flash{ role: "status", "aria-live": "polite" }
      = render "shared/flash"

    -# Navigation principale responsive
    - if user_signed_in?
      - admin_draft_count = current_user.admin? ? Recipe.draft.count : 0
      %header.main-header
        %nav.nav-container{ data: { controller: "menu" } }
          .nav-brand
            = link_to root_path, class: "brand-link" do
              = image_tag "logos/logo_EasyMeal.svg", alt: "EasyMeal", class: "logo"

          -# Liens de navigation principaux (masqués sur mobile)
          .header-nav-links
            = link_to "Recettes", recipes_path, class: header_nav_class(:recipes)
            = link_to "Mes menus", menus_path, class: header_nav_class(:menus)
            - if (active = current_active_menu)
              = link_to "Menu en cours", menu_path(active), class: header_nav_class(:current)
              = link_to "Courses", grocery_menu_path(active), class: header_nav_class(:grocery)
            - if current_user&.admin?
              = link_to recipe_drafts_path, class: "nav-link nav-link--admin" do
                = "Recettes importées"
                - if admin_draft_count > 0
                  %span.nav-badge= admin_draft_count

          -# Menu utilisateur (avatar desktop / hamburger mobile)
          .user-menu
            %button.user-menu-button{ type: "button",
                                      "aria-haspopup": "true",
                                      "aria-expanded": "false",
                                      "aria-controls": "user-menu-dropdown",
                                      "aria-label": "Menu utilisateur",
                                      data: { action: "click->menu#toggle", menu_target: "button" } }
              .user-avatar
                = current_user.first_name[0].upcase + current_user.last_name[0].upcase
              %span.user-name= current_user.first_name
              %svg.chevron{ width: "12", height: "12", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "3" }
                %polyline{ points: "6 9 12 15 18 9" }
              -# Icône hamburger (visible uniquement sur mobile via CSS)
              %svg.hamburger-icon{ width: "22", height: "22", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2" }
                %line{ x1: "3", y1: "6", x2: "21", y2: "6" }
                %line{ x1: "3", y1: "12", x2: "21", y2: "12" }
                %line{ x1: "3", y1: "18", x2: "21", y2: "18" }

            .user-dropdown#user-menu-dropdown{ data: { menu_target: "dropdown" } }
              -# Liens de navigation dans le dropdown (mobile uniquement via CSS)
              .dropdown-nav-links
                = link_to "Recettes", recipes_path, class: "dropdown-link"
                = link_to "Mes menus", menus_path, class: "dropdown-link"
                - if (active = current_active_menu)
                  = link_to "Menu en cours", menu_path(active), class: "dropdown-link"
                  = link_to "Courses", grocery_menu_path(active), class: "dropdown-link"
                - if current_user&.admin?
                  = link_to recipe_drafts_path, class: "dropdown-link dropdown-link--admin" do
                    = "Recettes importées"
                    - if admin_draft_count > 0
                      %span.nav-badge= admin_draft_count
                .dropdown-divider

              .dropdown-links
                = link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-link logout" do
                  %svg{ width: "18", height: "18", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2" }
                    %path{ d: "M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" }
                    %polyline{ points: "16 17 21 12 16 7" }
                    %line{ x1: "21", y1: "12", x2: "9", y2: "12" }
                  %span Me déconnecter
    - else
      %header.main-header.auth-header
        %nav.nav-container
          .nav-brand
            = link_to root_path, class: "brand-link" do
              = image_tag "logos/logo_EasyMeal.svg", alt: "EasyMeal", class: "logo"
          .nav-links
            = link_to "Se connecter", new_user_session_path, class: "nav-link"
            = link_to "S'inscrire", new_user_registration_path, class: "nav-link btn-signup"

    -# tabindex="-1" : la cible du skip-link doit pouvoir recevoir le focus
    -# programmatiquement (sinon certains navigateurs ne font que scroller).
    %main#main-content.main-content{ tabindex: "-1" }
      = yield
