-# UC3 — Page dédiée de la liste de courses (menu actif)
-# @menu : Menu(status: :active)
-# @grocery_items : collection triée GroceryItem
- content_for :title, "Liste de courses"
-# Liste partagée par le foyer : quand un membre coche, ajoute ou prend un
-# article, les autres écrans ouverts ici se rafraîchissent d'eux-mêmes — en
-# morph, défilement conservé, pour que la page bouge le moins possible sous
-# les yeux de qui fait ses courses (cf. GroceryItem, morph_keep.js).
- turbo_refreshes_with method: :morph, scroll: :preserve

.mc-page-outer
  -# L'abonnement au flux de la liste. live-refresh rattrape ce qu'une coupure
  -# a fait manquer (réseau perdu, téléphone en veille) ; son attribut
  -# « connected », posé par Turbo, n'est pas connu du serveur (morph_keep).
  %div{ data: { controller: "live-refresh" } }
    = turbo_stream_from(*@menu.grocery_stream, data: { morph_keep: "connected" })

  -# La pop-up « Mes habituelles » s'ouvre depuis deux endroits de la page — le
  -# rappel en tête, le bouton du bas : son contrôleur couvre donc toute la page.
  .mc-page-wrap{ data: { controller: "usual-groceries", usual_groceries_url_value: usual_menu_grocery_items_path(@menu) } }

    -# ── En-tête ──────────────────────────────────────────────
    -# Lien retour : on arrive ici directement après validation du menu (plus
    -# de détour par sa vue en lecture seule), il faut donc un accès explicite
    -# vers le menu pour retrouver "Modifier ce menu" / "Supprimer le menu".
    .mc-page-header
      .mc-page-title Liste de courses
      = link_to menu_path(@menu), class: "mc-head-action" do
        = svg_icon("chevron-left", size: 12)
        Voir le menu
    -# ── Menu en cours de modification ────────────────────────
    -# La liste reste consultable pendant qu'un membre retouche le menu : on
    -# annonce seulement qu'elle peut encore bouger (cf. R3.2bis).
    - if @menu.pending_revalidation?
      %p.grocery-menu-alert
        = svg_icon("info", size: 13)
        = grocery_pending_revalidation_notice(@menu)

    -# ── Courses habituelles pas encore ajoutées ──────────────
    - if @menu.usual_groceries_pending?
      = render "usual_grocery_additions/reminder", menu: @menu

    -# ── Liste groupée par rayon ──────────────────────────────
    = render "grocery_list", menu: @menu, grocery_items: @grocery_items

    -# ── Ajout hors menu ──────────────────────────────────────
    -# Un article à la fois (formulaire commun avec les courses habituelles), ou
    -# toute la liste des habituels du foyer d'un bouton (UC8, étape 3).
    .grocery-add-manual
      .grocery-add-manual-head
        .grocery-add-manual-label Ajouter un article
        -# Blanc : sur le beige de la page, le bouton secondaire (beige) s'effaçait
        %button.btn.btn-white{ type: "button", data: { action: "usual-groceries#open" } }
          = svg_icon("rotate-ccw", size: 14, css_class: "usual-sign")
          Mes habituelles
      = render "grocery_items/add_form", url: menu_grocery_items_path(@menu), scope: :grocery_item

    = render "usual_grocery_additions/dialog"
