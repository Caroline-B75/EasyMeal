-# Formulaire de génération d'un menu (UC1)
-# Design card-based avec régime radio, compteur de personnes, slider de repas, nom optionnel
-# Conforme au mockup easymeal_generate_menu_v2 — grille 2×2 pour régimes, icônes thématiques
- default_diet = menu.diet || current_user.default_diet || "omnivore"
- default_people = menu.default_people || current_user.default_people || 4
- default_meals = 7
- default_name_placeholder = "Menu du #{french_date(Date.today)}"

= form_with model: menu, url: menus_path, method: :post, class: "mn-generate-form",
            data: { controller: "menu-generate" } do |f|

  -# ── Carte 1 — Régime alimentaire (grille 2×2 avec icônes) ────────
  .mn-form-card{ role: "radiogroup", "aria-labelledby": "diet-label" }
    .mn-form-card-header
      .mn-form-card-num 1
      %span#diet-label.mn-form-card-title Régime alimentaire
    .mn-form-card-body
      .mn-diet-grid
        -# Omnivore
        %label.mn-diet-option{ class: ("omnivore" == default_diet ? "selected" : ""),
                               role: "radio",
                               "aria-checked": ("omnivore" == default_diet).to_s,
                               data: { action: "click->menu-generate#selectDiet",
                                       menu_generate_target: "dietOption" } }
          .mn-diet-icon.mn-diet-icon--omni{ "aria-hidden": "true" }
            %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
              %path{ d: "M10 3C7 3 4 5.5 4 9C4 12 6 14 8 15H12C14 14 16 12 16 9C16 5.5 13 3 10 3Z", fill: "#D73A49" }
              %path{ d: "M7 10.5 Q10 13 13 10.5", stroke: "white", "stroke-width": 1.2, fill: "none", "stroke-linecap": "round" }
          = f.radio_button :diet, "omnivore", checked: "omnivore" == default_diet,
                           class: "mn-diet-radio-input",
                           data: { action: "change->menu-generate#updateSummary",
                                   menu_generate_target: "dietInput" }
          .mn-diet-text
            %span.mn-diet-name= menu_diet_label("omnivore")
            %span.mn-diet-desc= menu_diet_description("omnivore")
          %span.mn-diet-radio

        -# Végétarien
        %label.mn-diet-option{ class: ("vegetarien" == default_diet ? "selected" : ""),
                               role: "radio",
                               "aria-checked": ("vegetarien" == default_diet).to_s,
                               data: { action: "click->menu-generate#selectDiet",
                                       menu_generate_target: "dietOption" } }
          .mn-diet-icon.mn-diet-icon--vege{ "aria-hidden": "true" }
            %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
              %path{ d: "M5 15C5 15 6 8 12 5C12 5 10 11 5 15Z", fill: "#639922" }
              %circle{ cx: 13, cy: 7, r: 2, fill: "#97C459" }
          = f.radio_button :diet, "vegetarien", checked: "vegetarien" == default_diet,
                           class: "mn-diet-radio-input",
                           data: { action: "change->menu-generate#updateSummary",
                                   menu_generate_target: "dietInput" }
          .mn-diet-text
            %span.mn-diet-name= menu_diet_label("vegetarien")
            %span.mn-diet-desc= menu_diet_description("vegetarien")
          %span.mn-diet-radio

        -# Vegan
        %label.mn-diet-option{ class: ("vegan" == default_diet ? "selected" : ""),
                               role: "radio",
                               "aria-checked": ("vegan" == default_diet).to_s,
                               data: { action: "click->menu-generate#selectDiet",
                                       menu_generate_target: "dietOption" } }
          .mn-diet-icon.mn-diet-icon--vegan{ "aria-hidden": "true" }
            %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
              %path{ d: "M4 14C7 8 13 5 16 6C15 9 11 14 6 15L4 14Z", fill: "#1D9E75" }
              %path{ d: "M10 11C10 11 9 9 10 7", stroke: "#5DCAA5", "stroke-width": 1.2, "stroke-linecap": "round" }
          = f.radio_button :diet, "vegan", checked: "vegan" == default_diet,
                           class: "mn-diet-radio-input",
                           data: { action: "change->menu-generate#updateSummary",
                                   menu_generate_target: "dietInput" }
          .mn-diet-text
            %span.mn-diet-name= menu_diet_label("vegan")
            %span.mn-diet-desc= menu_diet_description("vegan")
          %span.mn-diet-radio

        -# Pescétarien
        %label.mn-diet-option{ class: ("pescetarien" == default_diet ? "selected" : ""),
                               role: "radio",
                               "aria-checked": ("pescetarien" == default_diet).to_s,
                               data: { action: "click->menu-generate#selectDiet",
                                       menu_generate_target: "dietOption" } }
          .mn-diet-icon.mn-diet-icon--pesc{ "aria-hidden": "true" }
            %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
              %path{ d: "M4 10C4 10 7 6 12 8C12 8 14 9 15 10C14 11 12 12 12 12C7 14 4 10 4 10Z", fill: "#378ADD" }
              %circle{ cx: 14.5, cy: 9.5, r: 1, fill: "#185FA5" }
          = f.radio_button :diet, "pescetarien", checked: "pescetarien" == default_diet,
                           class: "mn-diet-radio-input",
                           data: { action: "change->menu-generate#updateSummary",
                                   menu_generate_target: "dietInput" }
          .mn-diet-text
            %span.mn-diet-name= menu_diet_label("pescetarien")
            %span.mn-diet-desc= menu_diet_description("pescetarien")
          %span.mn-diet-radio

  -# ── Cartes 2 & 3 — Personnes + Repas (côte à côte sur desktop) ───
  .mn-two-col
    -# ── Carte 2 — Nombre de personnes (slider) ─────────────
    .mn-form-card
      .mn-form-card-header
        .mn-form-card-num 2
        %span.mn-form-card-title Nombre de personnes / repas
      .mn-form-card-body.mn-form-card-body--compact
        .mn-slider-display
          .mn-slider-icon.mn-slider-icon--people{ "aria-hidden": "true" }
            %svg{ width: 20, height: 20, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": 2, "stroke-linecap": "round", "stroke-linejoin": "round" }
              %path{ d: "M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" }
              %circle{ cx: 12, cy: 7, r: 4 }
          %span.mn-slider-big{ data: { menu_generate_target: "peopleDisplay" } }= default_people
          %span.mn-slider-label{ data: { menu_generate_target: "peopleUnit" } }
            = default_people == 1 ? "personne" : "personnes"
        = f.range_field :default_people, min: 1, max: 12, value: default_people,
                        class: "mn-slider",
                        "aria-label": "Nombre de personnes par repas",
                        data: { action: "input->menu-generate#updatePeople",
                                menu_generate_target: "peopleSlider" }
        .mn-slider-marks
          %span.mn-slider-mark 1
          %span.mn-slider-mark 6
          %span.mn-slider-mark 12

    -# ── Carte 3 — Nombre de repas (slider) ─────────────────
    .mn-form-card
      .mn-form-card-header
        .mn-form-card-num 3
        %span.mn-form-card-title Nombre de repas
      .mn-form-card-body.mn-form-card-body--compact
        .mn-slider-display
          .mn-slider-icon.mn-slider-icon--meals{ "aria-hidden": "true" }
            %svg{ width: 20, height: 20, viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": 2, "stroke-linecap": "round", "stroke-linejoin": "round" }
              %path{ d: "M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" }
              %path{ d: "M7 2v20" }
              %path{ d: "M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" }
          %span.mn-slider-big{ data: { menu_generate_target: "mealsDisplay" } }= default_meals
          %span.mn-slider-label repas
        = f.range_field :number_of_meals, min: 1, max: 14, value: default_meals,
                        class: "mn-slider",
                        "aria-label": "Nombre de repas",
                        data: { action: "input->menu-generate#updateMeals",
                                menu_generate_target: "mealsSlider" }
        .mn-slider-marks
          %span.mn-slider-mark 1
          %span.mn-slider-mark 7
          %span.mn-slider-mark 14

  -# ── Carte 4 — Nom du menu (optionnel) ──────────────────
  .mn-form-card
    .mn-form-card-header
      .mn-form-card-num 4
      %span.mn-form-card-title
        Nom du menu
        %span.mn-field-optional — optionnel
    .mn-form-card-body
      = f.text_field :name, value: menu.name, maxlength: 60,
                     placeholder: "Ex : Menu de la semaine, Repas de vacances…",
                     class: "mn-text-input"
      %p.mn-field-hint
        Si laissé vide, le menu sera nommé
        = "\"#{default_name_placeholder}\"."

  -# ── Bouton de soumission ───────────────────────────────
  .mn-submit-zone
    %button.mn-btn-generate{ type: "submit",
                             data: { menu_generate_target: "submitBtn" } }
      = svg_icon("sparkle", size: 16)
      Générer mon menu
    %p.mn-submit-note La génération prend quelques secondes. Les recettes sont sélectionnées en priorité parmi celles de saison.
