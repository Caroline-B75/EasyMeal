-# Carte compacte d'un repas en lecture seule (dashboards de la home)
-# Même design que la carte de personnalisation mais sans actions (drag/replace/delete)
-# — la page du menu actif, elle, rend menus/_menu_recipe_card en mode figé.
-# menu_recipe : MenuRecipe

= link_to recipe_path(menu_recipe.recipe), class: "mc-recipe-card mc-recipe-card--readonly", data: { turbo_prefetch: "false" } do
  -# ── Photo carrée ──────────────────────────────────────
  .mc-card-photo
    = render "menus/recipe_photo", recipe: menu_recipe.recipe

  -# ── Nom de la recette ─────────────────────────────────
  .mc-card-name-wrap
    .mc-card-name= menu_recipe.recipe.name

  -# ── Méta : nombre de personnes ────────────────────────
  .mc-card-meta
    %span.mc-card-meta-people= "#{menu_recipe.number_of_people} pers."
