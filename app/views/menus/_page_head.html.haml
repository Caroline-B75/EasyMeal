-# En-tête de la page d'un menu (brouillon ou actif), rendu dans .mc-page-wrap.
-#
-# Le nom du menu ouvre la page : c'est l'identité de ce qu'on regarde, il ne
-# doit être précédé de rien. Le statut est une métadonnée du titre — il vit
-# donc dans la ligne de méta juste en dessous plutôt que sur une ligne à lui,
-# qui porte aussi les actions secondaires, alignées à droite. Les actions
-# principales (valider, voir la liste) sont le CTA en bas de page. Les réglages
-# qui s'appliquent à tout le menu (brouillon) vivent à part, dans
-# menus/_settings_panel — colonne latérale à côté de la grille de repas
-# (voir _draft_view, .mc-split).
-#
-# Le brouillon rend le nom modifiable sur place via le controller menu-params,
-# porté par l'ancêtre commun .mc-page-wrap (qui englobe aussi le panneau de
-# réglages : un seul et même contrôleur pilote les deux). L'en-tête est la
-# cible du Turbo Stream de mise à jour (voir update.turbo_stream.haml) : c'est
-# pourquoi il porte l'id, et non ses sous-parties.
-#
-# Locals :
-#   menu         : Menu (brouillon ou actif)
-#   menu_recipes : collection ordonnée des MenuRecipe
- draft = menu.status_draft?

.mc-head{ id: "menu_head_#{menu.id}" }

  -# ── Nom du menu ──────────────────────────────────────────────
  -# Brouillon : champ éditable sur place, enregistré au blur (ou à Entrée).
  - if draft
    = form_with model: menu, url: menu_path(menu), method: :patch, class: "mc-head-title-row",
                data: { menu_params_target: "nameForm" } do |f|
      -# size dimensionne le champ sur la longueur du nom : le crayon reste collé
      -# au titre au lieu d'être repoussé par un champ pleine largeur.
      = f.text_field :name, value: menu.name, maxlength: 60, placeholder: "Nom du menu",
                     size: [menu.name.to_s.length + 3, 14].max,
                     class: "mc-head-title-input", "aria-label": "Nom du menu",
                     data: { menu_params_target: "nameInput",
                             action: "blur->menu-params#saveName keydown.enter->menu-params#blurName" }
      %button.mc-head-title-edit{ type: "button", title: "Renommer le menu", "aria-label": "Renommer le menu",
                                  data: { action: "click->menu-params#focusName" } }
        = svg_icon("edit", size: 13)
  - else
    .mc-head-title-row
      %h1.mc-head-title= menu.name.presence || "Menu sans nom"

  -# ── Statut + méta + actions secondaires ──────────────────────
  .mc-head-meta
    .mc-head-meta-facts
      %span{ class: "mc-kicker mc-kicker--#{menu.status}" }= menu_head_kicker_label(menu)

      -# Compteur mis à jour en direct par menu-customize (ajout / retrait de repas)
      %span{ data: { menu_customize_target: ("countChip" if draft) } }= "#{menu_recipes.size} repas"
      - menu_head_meta_details(menu).each do |detail|
        %span.mc-head-meta-sep ·
        %span= detail

    -# Rendues en liens discrets et non en boutons : ce sont des actions rares,
    -# un bouton encadré appellerait le clic. Pour la suppression, le rouge
    -# n'apparaît qu'au survol / focus, juste avant le clic.
    .mc-head-meta-actions
      -# Repasser en brouillon n'a de sens que sur un menu déjà validé
      - unless draft
        = button_to revert_to_draft_menu_path(menu), method: :post, class: "mc-head-action",
                    form: { data: { turbo_confirm: menu_revert_to_draft_confirm(menu) } } do
          = svg_icon("edit", size: 12)
          Modifier ce menu
      = button_to menu_path(menu), method: :delete,
                  class: "mc-head-action mc-head-action--danger",
                  form: { data: { turbo_confirm: "Supprimer ce menu définitivement ?" } } do
        = svg_icon("trash", size: 12)
        Supprimer le menu
