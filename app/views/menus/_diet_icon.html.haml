-# Icône thématique d'un régime alimentaire (fond coloré + pictogramme SVG).
-# Utilisé par la grille de régimes du formulaire de paramètres de menu.
-# diet : clé string du régime (une clé de Menu.diets).
-# Un régime inconnu retombe sur une icône neutre — rien ne casse si l'enum évolue.
- case diet.to_s
- when "omnivore"
  .mn-diet-icon.mn-diet-icon--omni{ "aria-hidden": "true" }
    %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
      %path{ d: "M10 3C7 3 4 5.5 4 9C4 12 6 14 8 15H12C14 14 16 12 16 9C16 5.5 13 3 10 3Z", fill: "#D73A49" }
      %path{ d: "M7 10.5 Q10 13 13 10.5", stroke: "white", "stroke-width": 1.2, fill: "none", "stroke-linecap": "round" }
- when "vegetarien"
  .mn-diet-icon.mn-diet-icon--vege{ "aria-hidden": "true" }
    %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
      %path{ d: "M5 15C5 15 6 8 12 5C12 5 10 11 5 15Z", fill: "#639922" }
      %circle{ cx: 13, cy: 7, r: 2, fill: "#97C459" }
- when "vegan"
  .mn-diet-icon.mn-diet-icon--vegan{ "aria-hidden": "true" }
    %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
      %path{ d: "M4 14C7 8 13 5 16 6C15 9 11 14 6 15L4 14Z", fill: "#1D9E75" }
      %path{ d: "M10 11C10 11 9 9 10 7", stroke: "#5DCAA5", "stroke-width": 1.2, "stroke-linecap": "round" }
- when "pescetarien"
  .mn-diet-icon.mn-diet-icon--pesc{ "aria-hidden": "true" }
    %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none" }
      %path{ d: "M4 10C4 10 7 6 12 8C12 8 14 9 15 10C14 11 12 12 12 12C7 14 4 10 4 10Z", fill: "#378ADD" }
      %circle{ cx: 14.5, cy: 9.5, r: 1, fill: "#185FA5" }
- else
  .mn-diet-icon.mn-diet-icon--default{ "aria-hidden": "true" }
    %svg{ width: 18, height: 18, viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", "stroke-width": 1.4 }
      %circle{ cx: 10, cy: 10, r: 6 }
