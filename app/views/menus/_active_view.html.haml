-# UC3/UC7 — Vue menu actif : même grille de cartes que le brouillon, recentrée
-# sur la vie du menu validé — le jour reste annotable (pure information, la
-# liste de courses n'y est pas sensible) et les cartes se réorganisent (drag &
-# drop, ⬆️/⬇️ au doigt) ; moment, personnes et composition sont figés.
-# menu-customize est le même contrôleur que sur le brouillon : drag & drop et
-# teinte de jour y sont identiques.
-# menu : Menu(status: :active)
-# menu_recipes : collection ordonnée des MenuRecipe

.mc-page-outer{ data: { controller: "menu-customize",
                        menu_customize_reorder_url_value: reorder_menu_menu_recipes_path(menu) } }
  .mc-page-wrap

    = render "menus/page_head", menu: menu, menu_recipes: menu_recipes

    = render "menus/active_meals", menu: menu, menu_recipes: menu_recipes
