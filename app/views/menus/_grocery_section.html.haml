-# Rayon de la liste de courses (accordéon)
-# category : String (clé enum, ex: "fruits_legumes") ou nil
-# items    : collection GroceryItem triés
-# menu     : Menu
- section_id    = "grocery_section_#{(category.presence || 'divers').parameterize}"
- category_name = category ? Ingredient.human_attribute_name("category.#{category}") : "Divers"

= turbo_frame_tag section_id do
  .grocery-section{ data: { controller: "grocery-accordion",
                             "grocery-accordion-open-value": "true",
                             category: category.presence || "autre" } }
    %button.grocery-section-header{ type: "button",
                                     data: { action: "click->grocery-accordion#toggle" } }
      %span.grocery-section-title= category_name
      %span.grocery-section-count= items.size
      .grocery-section-chevron{ data: { "grocery-accordion-target": "chevron" } }

    .grocery-section-body{ data: { "grocery-accordion-target": "body" } }
      .grocery-items-list
        - items.each do |item|
          = render "menus/grocery_item", item: item, menu: menu
