-# Réponse Turbo Stream à la mise à jour inline du nom ou du nombre de personnes.
-# Remplace l'en-tête complet du menu (re-render avec les nouvelles valeurs).
-# Si le nombre de personnes a changé, met à jour également toutes les cartes recettes.

= turbo_stream.replace "menu_head_#{@menu.id}" do
  = render "menus/page_head", menu: @menu, menu_recipes: @menu_recipes

- if @people_changed
  - @menu_recipes.each do |mr|
    = turbo_stream.replace "menu_recipe_#{mr.id}" do
      = render "menus/menu_recipe_card", menu_recipe: mr, menu: @menu
