-# UC2/UC7 — Vue brouillon : personnalisation du menu, une grille de repas
-# Design : mockup easymeal_menu_customize.html — Slate Craft Premium
-# menu : Menu(status: :draft)
-# menu_recipes : collection ordonnée des MenuRecipe

.mc-page-outer{ data: { controller: "menu-customize",
                        menu_customize_reorder_url_value: reorder_menu_menu_recipes_path(menu) } }
  -# menu-params : porté par cet ancêtre commun, pas par l'en-tête ou le panneau
  -# de réglages pris isolément — il pilote le nom éditable (dans l'en-tête,
  -# .mc-split-main) ET le stepper + le sélecteur de régime (dans le panneau,
  -# .mc-split-aside), deux sous-arbres distincts.
  .mc-page-wrap{ data: { controller: "menu-params" } }

    = render "menus/page_head", menu: menu, menu_recipes: menu_recipes

    .mc-split
      -# mobile-accordion : porté par l'aside et non par le panneau lui-même,
      -# car celui-ci est remplacé par un Turbo Stream à chaque +/- du stepper —
      -# l'état plié/déplié survit ainsi au re-render.
      .mc-split-aside{ data: { controller: "mobile-accordion" } }
        = render "menus/settings_panel", menu: menu, menu_recipes: menu_recipes

      = render "menus/draft_meals", menu: menu, menu_recipes: menu_recipes
